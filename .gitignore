# Python bytecode and generated caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, type-checking and linting caches
.pytest_cache/
.mypy_cache/
.pyre/
.hypothesis/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging artifacts
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Project-local cache and temporary files
.cache/
*.tmp
*.temp

# Jupyter generated metadata
.ipynb_checkpoints/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ignore generated capture files, but keep the folders and info.txt files
capture_data/converted_npz/files/**/*.npz
capture_data/raw_mvnx/files/**/*.mvnx